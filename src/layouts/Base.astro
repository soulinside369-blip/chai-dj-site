---
import '../styles/global.css';
import { site, nav, url, links, formats, occasions, faq, isStub, isPreview } from '../lib/data';
import Calculator from '../components/Calculator.astro';
import Icon from '../components/Icon.astro';
import { rub } from '../lib/price.js';

interface Props {
  title?: string;
  description?: string;
  tone?: 'rice' | 'coal';      // тон первого экрана — шапка начинает в нём
  faqLd?: boolean;
  service?: { name: string; description: string; price: number };
  noindex?: boolean;
  faqItems?: { q: string; a: string }[];
}
const { title, description, tone = 'rice', faqLd = false, service, noindex = false, faqItems } = Astro.props;
const fullTitle = title ? `${title} — ${site.brand.name}` : site.seo.title;
const desc = description || site.seo.description;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(url('og.jpg'), Astro.site).href;
const path = Astro.url.pathname;
const current = (href: string) => path.startsWith(url(href));

const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.brand.name,
  description: site.seo.description,
  url: new URL(url(''), Astro.site).href,
  image: og,
  areaServed: site.brand.region,
  address: { '@type': 'PostalAddress', addressLocality: site.brand.city, addressCountry: 'RU' },
  ...(site.contacts.phone ? { telephone: site.contacts.phone } : {}),
  openingHours: `Mo-Su ${String(site.work.from).padStart(2, '0')}:00-${site.work.to}:00`,
  makesOffer: formats.map((f) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: f.name },
    priceSpecification: { '@type': 'PriceSpecification', minPrice: f.base, priceCurrency: 'RUB' },
  })),
};
const faqSource = faqItems ?? (faqLd ? faq.groups.flatMap((g) => g.items) : null);
const faqSchema = faqSource && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqSource.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
const serviceSchema = service && {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.description,
  provider: { '@type': 'LocalBusiness', name: site.brand.name },
  areaServed: site.brand.region,
  offers: { '@type': 'Offer', price: service.price, priceCurrency: 'RUB' },
};
const metrika = site.analytics.metrikaId;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  {(noindex || isPreview) && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content={tone === 'rice' ? '#EDE6DA' : '#1C1B18'} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <slot name="head" />
  <script type="speculationrules" is:inline set:html={JSON.stringify({ prerender: [{ where: { and: [{ href_matches: url('*') }, { not: { href_matches: [url('admin/*'), url('api/*'), url('docs/*')] } }] }, eagerness: 'moderate' }] })} />
  <script is:inline>document.documentElement.classList.add('js')</script>
  <script type="application/ld+json" set:html={JSON.stringify(business)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  {serviceSchema && <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />}
  {metrika && (
    <script is:inline define:vars={{ metrika }}>
      (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');
      ym(metrika,'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:true});
      window.__ym = metrika;
    </script>
  )}
</head>
<body data-seg={site.hero.defaultSegment}>
  <script is:inline>try{var s=localStorage.getItem('cdj_seg');if(s)document.body.dataset.seg=s}catch(e){}</script>
  <slot name="top" />
  <a class="skip" href="#main">К содержанию</a>

  <header class="site-h" data-tone={tone} id="siteHeader">
    <div class="wrap">
      <a class="logo" href={url('')} aria-label={`${site.brand.name} — на главную`}>
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 17h22c0 6-5 10-11 10S5 23 5 17z"/><path d="M11 13c-1-2 1-3 0-5M16 13c-1-2 1-3 0-5M21 13c-1-2 1-3 0-5"/></svg>
        {site.brand.name}
      </a>
      <nav class="nav" aria-label="Основное меню" data-pillnav>
        <span class="nav-pill" aria-hidden="true"></span>
        {nav.map((n) => <a href={url(n.href)} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <a class="btn sm h-cta" href={url('kontakty/')} data-calc-link data-goal="click_calc">Рассчитать стоимость</a>
    </div>
    <span class="h-progress" aria-hidden="true"></span>
  </header>

  <div class="sheet-scrim" data-menu-close hidden></div>
  <div class="sheet tone-coal" id="menu" role="dialog" aria-modal="true" aria-label="Меню" aria-hidden="true" inert>
    <button class="sheet-grip" type="button" data-menu-close aria-label="Закрыть меню"><span></span></button>
    <div class="sheet-body">
      <p class="sheet-k">Форматы</p>
      <div class="sheet-tiles">
        {formats.map((f) => (
          <a class="s-tile" href={url(f.slug + '/')} aria-current={current(f.slug + '/') ? 'page' : undefined}>
            <Icon name={f.key} />
            <b>{f.name}</b>
            <span>от {rub(f.base)}</span>
          </a>
        ))}
      </div>
      <p class="sheet-k">Под повод</p>
      <div class="sheet-chips">
        {occasions.map((o) => <a class="chip" href={url(o.slug + '/')}>{o.menu}</a>)}
        <a class="chip" href={url('sertifikaty/')}>Сертификат в подарок</a>
      </div>
      <nav class="sheet-links" aria-label="Разделы">
        {nav.map((n) => <a href={url(n.href)} aria-current={current(n.href) ? 'page' : undefined}>{n.label}<span aria-hidden="true">→</span></a>)}
      </nav>
      <div class="sheet-contacts">
        <a class="btn ghost sm" href={links.telegram} data-goal="click_telegram">Telegram</a>
        <a class="btn ghost sm" href={links.max} data-goal="click_max">MAX</a>
        {links.phone && <a class="btn ghost sm" href={links.phone} data-goal="click_phone">Позвонить</a>}
      </div>
      <small class="sheet-note">{site.work.text}</small>
    </div>
  </div>

  <main id="main"><slot /></main>

  <footer class="site-f tone-coal">
    <div class="wrap">
      <div class="f-cta">
        <p class="f-title display">Соберём ваш вечер — от первой чашки до последнего трека</p>
        <div class="row">
          <a class="btn brass" href={url('kontakty/')} data-calc-link data-goal="click_calc">Рассчитать <span class="arr">→</span></a>
          <a class="btn ghost" href={links.telegram} data-goal="click_telegram">Telegram</a>
          <a class="btn ghost" href={links.max} data-goal="click_max">MAX</a>
        </div>
      </div>
      <div class="f-grid">
        <div style="display:grid;gap:10px;align-content:start">
          <a class="logo" href={url('')}>{site.brand.name}</a>
          <p class="muted">{site.brand.tagline}. {site.brand.region}.</p>
          {links.phone && <a href={links.phone} data-goal="click_phone" class="link">{site.contacts.phoneDisplay}</a>}
          <p class="muted">{site.work.text}</p>
        </div>
        <div><p class="eyebrow" style="margin-bottom:14px">Форматы</p><ul>
          {formats.map((f) => <li><a href={url(f.slug + '/')}>{f.name}</a></li>)}
          <li><a href={url('sertifikaty/')}>Сертификаты</a></li>
        </ul></div>
        <div><p class="eyebrow" style="margin-bottom:14px">Поводы</p><ul>
          {occasions.map((o) => <li><a href={url(o.slug + '/')}>{o.menu}</a></li>)}
        </ul></div>
        <div class="f-company"><p class="eyebrow" style="margin-bottom:14px">Компания</p><ul>
          {nav.map((n) => <li><a href={url(n.href)}>{n.label}</a></li>)}
        </ul></div>
        <div><p class="eyebrow" style="margin-bottom:14px">Документы</p><ul>
          <li><a href={url('privacy/')}>Политика ПДн</a></li>
          <li><a href={url('consent/')}>Согласие на обработку</a></li>
          <li><a href={url('oferta/')}>Оферта</a></li>
          <li class="muted">© {new Date().getFullYear()} {isStub(site.brand.legal) ? site.brand.name : site.brand.legal}</li>
        </ul></div>
      </div>
    </div>
  </footer>

  <dialog class="drawer tone-coal2" id="calcDrawer" aria-labelledby="drawer-title">
    <div class="drawer-head">
      <p class="drawer-title display" id="drawer-title">Расчёт стоимости</p>
      <button type="button" class="drawer-close" data-drawer-close aria-label="Закрыть расчёт">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <Calculator />
  </dialog>

  <nav class="tbar" id="dock" aria-label="Быстрые действия">
    <a class="tb" href={url('uslugi/')} aria-current={current('uslugi/') ? 'page' : undefined}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="2"/><rect x="13.5" y="3.5" width="7" height="7" rx="2"/><rect x="3.5" y="13.5" width="7" height="7" rx="2"/><rect x="13.5" y="13.5" width="7" height="7" rx="2"/></svg>
      <span>Форматы</span>
    </a>
    <a class="tb" href={links.telegram} data-goal="click_telegram">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 4 3 11l6 2 2 6 3-4 5 4z"/><path d="m9 13 8-6"/></svg>
      <span>Связь</span>
    </a>
    <button class="tb" type="button" data-menu-toggle aria-controls="menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h10"/></svg>
      <span>Меню</span>
    </button>
    <a class="tb-main" href={url('kontakty/')} data-calc-link data-goal="click_calc">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="3"/><path d="M8.5 7.5h7M8.5 12h1M12 12h1M15.5 12h0M8.5 16h1M12 16h1M15.5 16h0"/></svg>
      <span>Рассчитать</span>
    </a>
  </nav>

  <script>
    import '../scripts/fx';
  </script>
</body>
</html>
