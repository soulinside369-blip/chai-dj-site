---
import '../styles/global.css';
import { site, nav, url, links, formats, faq } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
  tone?: 'rice' | 'coal';      // тон первого экрана — шапка начинает в нём
  faqLd?: boolean;
  service?: { name: string; description: string; price: number };
  noindex?: boolean;
}
const { title, description, tone = 'rice', faqLd = false, service, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.brand.name}` : site.seo.title;
const desc = description || site.seo.description;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(url('og.jpg'), Astro.site).href;
const path = Astro.url.pathname;
const current = (href: string) => path.startsWith(url(href));

const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.brand.name,
  description: site.seo.description,
  url: new URL(url(''), Astro.site).href,
  image: og,
  areaServed: site.brand.region,
  address: { '@type': 'PostalAddress', addressLocality: site.brand.city, addressCountry: 'RU' },
  ...(site.contacts.phone ? { telephone: site.contacts.phone } : {}),
  openingHours: `Mo-Su ${String(site.work.from).padStart(2, '0')}:00-${site.work.to}:00`,
  makesOffer: formats.map((f) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: f.name },
    priceSpecification: { '@type': 'PriceSpecification', minPrice: f.base, priceCurrency: 'RUB' },
  })),
};
const faqSchema = faqLd && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.groups.flatMap((g) => g.items).map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
const serviceSchema = service && {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.description,
  provider: { '@type': 'LocalBusiness', name: site.brand.name },
  areaServed: site.brand.region,
  offers: { '@type': 'Offer', price: service.price, priceCurrency: 'RUB' },
};
const metrika = site.analytics.metrikaId;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content={tone === 'rice' ? '#EDE6DA' : '#1C1B18'} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <script is:inline>document.documentElement.classList.add('js')</script>
  <script type="application/ld+json" set:html={JSON.stringify(business)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  {serviceSchema && <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />}
  {metrika && (
    <script is:inline define:vars={{ metrika }}>
      (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');
      ym(metrika,'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:true});
      window.__ym = metrika;
    </script>
  )}
</head>
<body>
  <a class="skip" href="#main">К содержанию</a>

  <header class="site-h" data-tone={tone} id="siteHeader">
    <div class="wrap">
      <a class="logo" href={url('')} aria-label={`${site.brand.name} — на главную`}>
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 17h22c0 6-5 10-11 10S5 23 5 17z"/><path d="M11 13c-1-2 1-3 0-5M16 13c-1-2 1-3 0-5M21 13c-1-2 1-3 0-5"/></svg>
        {site.brand.name}
      </a>
      <nav class="nav" aria-label="Основное меню">
        {nav.map((n) => <a href={url(n.href)} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <a class="btn sm h-cta" href={url('#calc')} data-calc-link data-goal="click_calc">Рассчитать стоимость</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="menu" aria-label="Открыть меню"><span></span></button>
    </div>
  </header>

  <div class="menu" id="menu" aria-hidden="true">
    <nav aria-label="Меню">
      <a href={url('chai-dj/')}>Чай + DJ</a>
      {nav.map((n) => <a href={url(n.href)}>{n.label}</a>)}
      <a href={url('sertifikaty/')}>Сертификаты</a>
    </nav>
    <div class="row">
      <a class="btn brass" href={url('#calc')} data-calc-link data-goal="click_calc">Рассчитать стоимость</a>
      <a class="btn ghost" style="--fg:var(--rice);--bg:var(--coal)" href={links.telegram} data-goal="click_telegram">Telegram</a>
    </div>
    <small>{site.work.text}</small>
  </div>

  <main id="main"><slot /></main>

  <footer class="site-f tone-coal">
    <div class="wrap">
      <div class="f-cta">
        <p class="eyebrow">Свободные даты разбирают к пятницам</p>
        <p class="h1 display">Соберём ваш вечер — от первой чашки до последнего трека</p>
        <div class="row">
          <a class="btn brass" href={url('#calc')} data-calc-link data-goal="click_calc">Рассчитать стоимость <span class="arr">→</span></a>
          <a class="btn ghost" href={links.telegram} data-goal="click_telegram">Написать в Telegram</a>
          <a class="btn ghost" href={links.max} data-goal="click_max">Написать в MAX</a>
        </div>
      </div>
      <div class="f-grid">
        <div style="display:grid;gap:10px;align-content:start">
          <a class="logo" href={url('')}>{site.brand.name}</a>
          <p class="muted">{site.brand.tagline}. {site.brand.region}.</p>
          {links.phone ? <a href={links.phone} data-goal="click_phone" class="link">{site.contacts.phoneDisplay}</a> : <span class="stub" style="justify-self:start">{site.contacts.phoneDisplay}</span>}
          <p class="muted">{site.work.text}</p>
        </div>
        <div><p class="eyebrow" style="margin-bottom:14px">Форматы</p><ul>
          {formats.map((f) => <li><a href={url(f.slug + '/')}>{f.name}</a></li>)}
          <li><a href={url('sertifikaty/')}>Сертификаты</a></li>
        </ul></div>
        <div><p class="eyebrow" style="margin-bottom:14px">Компания</p><ul>
          {nav.map((n) => <li><a href={url(n.href)}>{n.label}</a></li>)}
        </ul></div>
        <div><p class="eyebrow" style="margin-bottom:14px">Документы</p><ul>
          <li><a href={url('privacy/')}>Политика ПДн</a></li>
          <li><a href={url('consent/')}>Согласие на обработку</a></li>
          <li><a href={url('oferta/')}>Оферта</a></li>
          <li class="muted">© {new Date().getFullYear()} {site.brand.legal}</li>
        </ul></div>
      </div>
      <p class="f-big" aria-hidden="true">чай&nbsp;+&nbsp;dj</p>
    </div>
  </footer>

  <div class="dock" id="dock">
    <a class="btn brass sm" href={url('#calc')} data-calc-link data-goal="click_calc">Рассчитать</a>
    <a class="btn ghost sm" href={links.telegram} data-goal="click_telegram">Telegram</a>
  </div>

  <script>
    import '../scripts/fx';
  </script>
</body>
</html>
