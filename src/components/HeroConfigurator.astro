---
// Первый экран — «Конструктор вечера»: ползунок тишина ↔ танцпол, гости, заявка в 2 касания. Без цен — закрытый формат, индивидуальное предложение.
import { site, formats, calc, url } from '../lib/data';
import { typoLine } from '../../integrations/typograf.mjs';
const deep = (v: any): any => typeof v === 'string' ? typoLine(v) : Array.isArray(v) ? v.map(deep) : v && typeof v === 'object' ? Object.fromEntries(Object.entries(v).map(([k, x]) => [k, deep(x)])) : v;
const h = site.hero;
const seg = h.segments[h.defaultSegment as 'corp' | 'private'];
const stop0 = h.stops[1];
const sc = (h as any).scene || {};
const small = (s: string) => /-1280\.webp$/.test(s) ? `${url(s.replace(/-1280\.webp$/, '-640.webp'))} 640w, ${url(s.replace(/-1280\.webp$/, '-900.webp'))} 900w, ${url(s)} 1280w` : undefined;
const data = {
  formats: formats.map(({ key, name, base, G, a, H, b, maxH, maxGuests, what, duration }) => ({ key, name, base, G, a, H, b, maxH, maxGuests, what, duration })),
  calc, stops: deep(h.stops), segments: deep(h.segments), defaultSegment: h.defaultSegment, work: site.work,
  audio: Object.fromEntries(Object.entries((h as any).audio || {}).map(([k, v]) => [k, typeof v === 'string' && v ? url(v) : v])),
};
---
<section class="hero cfg tone-rice" data-htone="rice" data-cfg id="vecher">
  <script type="application/json" data-cfg-json set:html={JSON.stringify(data)} />
  <div class="wrap cfg-grid">
    <div class="cfg-copy">
      <div class="seg-switch" role="group" aria-label="Для кого вечер">
        {Object.entries(h.segments).map(([k, s]) => (
          <button type="button" class="seg-btn" data-seg={k} aria-pressed={k === h.defaultSegment ? 'true' : 'false'}>{s.label}</button>
        ))}
      </div>
      <p class="eyebrow">{h.eyebrow}</p>
      <h1 data-seg-text="title">{seg.title}</h1>
      <p class="lead lead-full" data-seg-text="lead">{seg.lead}</p>
      <p class="lead lead-short" data-seg-text="leadShort">{seg.leadShort}</p>
      <ul class="usp" data-seg-usp>
        {seg.usp.map((u) => { const [b, ...r] = u.split(' — '); return <li><b>{b}</b>{r.join(' — ')}</li>; })}
      </ul>
    </div>

    <div class="cfg-panel tone-coal2" aria-labelledby="cfg-title">
      <div class={`stage${sc.quiet ? ' has-photo' : ''}`} data-stage style="--p:.5">
        {sc.quiet && <img class="stage-img quiet" src={url(sc.quiet)} srcset={small(sc.quiet)} sizes="(max-width: 600px) calc(100vw - 40px), 520px" alt="" fetchpriority="high" decoding="async" />}
        {sc.party && <img class="stage-img party" data-src={url(sc.party)} data-srcset={small(sc.party)} sizes="(max-width: 600px) calc(100vw - 40px), 520px" alt="" loading="lazy" decoding="async" />}
        <canvas aria-hidden="true"></canvas>
        <div class="beams" aria-hidden="true"><i class="beam"></i><i class="beam"></i><i class="beam"></i></div>
        <svg class="stage-gaiwan" viewBox="0 0 400 300" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <ellipse cx="200" cy="268" rx="168" ry="22" fill="var(--stage-bg)" />
          <path d="M86 160 C88 228 140 258 200 258 C260 258 312 228 314 160" fill="var(--stage-bg)" />
          <ellipse cx="200" cy="160" rx="114" ry="14" fill="var(--stage-bg)" />
          <path d="M104 196 C150 214 250 214 296 196" stroke="var(--brass)" />
          <g transform="rotate(9 300 152) translate(-6 -8)">
            <path d="M92 152 C104 100 296 100 308 152 Z" fill="var(--stage-bg)" />
            <ellipse cx="200" cy="92" rx="22" ry="7" fill="var(--stage-bg)" />
          </g>
        </svg>
        <div class="stage-top">
          <p class="stage-time" data-time aria-hidden="true">{stop0.time}</p>
          <button type="button" class="sound-btn" data-sound aria-pressed="false">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9z"/><path class="wave1" d="M16 9a4 4 0 0 1 0 6"/><path class="wave2" d="M18.5 6.5a7.5 7.5 0 0 1 0 11"/></svg>
            <span>Включить звук</span>
          </button>
        </div>
        <p class="stage-label"><b data-stop-label>{stop0.label}</b><span data-stop-text>{stop0.text}</span></p>
      </div>

      <div class="cfg-controls">
        <h2 id="cfg-title" class="cfg-title">{h.sliderTitle}</h2>
        <div class="range">
          <input type="range" id="cfg-mood" min="0" max="100" step="1" value="50" aria-label="Характер вечера: от тишины до танцпола" aria-valuetext={`${stop0.label}: ${stop0.text}`} />
          <div class="range-ticks" aria-hidden="true">{h.stops.map((s) => <span>{s.label}</span>)}</div>
        </div>
        <div class="range guests">
          <label for="cfg-guests" class="range-head"><span>Гостей</span><output data-guests-out class="tnum">30</output></label>
          <input type="range" id="cfg-guests" min="5" max="150" step="5" value="30" />
        </div>

        <div class="cfg-result" aria-live="polite">
          <p class="cfg-fmt">Ваш вечер</p>
          <p class="cfg-price cfg-offer" data-price><span data-fmt-name>Чай + DJ</span></p>
          <p class="cfg-per muted" data-per>4 ч · 30 гостей · предложение под вашу задачу</p>
          <button type="button" class="cfg-share" data-share aria-label="Поделиться подборкой">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3M7 8l5-5 5 5"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/></svg>
            <span data-share-label>Поделиться</span>
          </button>
        </div>

        <button type="button" class="btn brass cfg-cta" data-book-open data-goal="hero_cta"><span data-seg-text="cta">{seg.cta}</span> <span class="arr">→</span></button>

        <p class="cfg-more muted">Смету и программу пришлём лично — в течение {site.work.replyMinutes} минут в рабочее время.</p>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/hero';
</script>
