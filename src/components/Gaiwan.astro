---
// Гайвань тонкой линией: рисуется при загрузке, над приоткрытой крышкой поднимается пар (scripts/steam.ts)
---
<div class="hero-art" data-steam>
  <canvas aria-hidden="true"></canvas>
  <svg class="gaiwan" viewBox="0 0 400 300" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" role="img" aria-label="Гайвань с приоткрытой крышкой, над ней поднимается пар">
    <ellipse class="draw" pathLength="1" cx="200" cy="268" rx="168" ry="22" fill="var(--rice)" />
    <ellipse class="draw" pathLength="1" cx="200" cy="268" rx="118" ry="13" style="--dd:.15s" />
    <path class="draw" pathLength="1" d="M86 160 C88 228 140 258 200 258 C260 258 312 228 314 160" fill="var(--rice)" style="--dd:.3s" />
    <ellipse class="draw" pathLength="1" cx="200" cy="160" rx="114" ry="14" fill="var(--rice)" style="--dd:.45s" />
    <path class="draw brassline" pathLength="1" d="M104 196 C150 214 250 214 296 196" style="--dd:.9s" />
    <g class="lid">
      <path class="draw" pathLength="1" d="M92 152 C104 100 296 100 308 152 Z" fill="var(--rice)" style="--dd:.6s" />
      <path class="draw" pathLength="1" d="M182 108 C182 92 218 92 218 108" fill="var(--rice)" style="--dd:.75s" />
      <ellipse class="draw" pathLength="1" cx="200" cy="92" rx="22" ry="7" fill="var(--rice)" style="--dd:.8s" />
    </g>
  </svg>
</div>

<style>
  .gaiwan .lid { transform-origin: 300px 152px; transform: rotate(9deg) translate(-6px, -8px); }
  .gaiwan .brassline { stroke: var(--brass-dark); stroke-dasharray: 1; }
  .js .gaiwan .draw { stroke-dasharray: 1; stroke-dashoffset: 1; fill-opacity: 0; animation: draw 1.6s var(--ease) forwards, fill .8s ease forwards; animation-delay: var(--dd, 0s), calc(var(--dd, 0s) + 1s); }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fill { to { fill-opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .js .gaiwan .draw { stroke-dashoffset: 0; fill-opacity: 1; animation: none; } }
</style>

<script>
  import '../scripts/steam';
</script>
