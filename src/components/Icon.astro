---
// Линейные иконки в один цвет (раздел 9 ТЗ: иконки форматов и УТП)
interface Props { name: string; class?: string }
const { name, class: cls = 'ico' } = Astro.props;
---
<svg class={cls} viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'teadj' && (<>
    <path d="M8 34h26l-3 9H11z"/><path d="M34 36c4 0 6-2 6-4s-2-3-4-3h-2"/>
    <path d="M14 28c-1-3 2-4 1-7M21 28c-1-3 2-4 1-7M28 28c-1-3 2-4 1-7"/>
    <path d="M44 12v22M48 18v10M40 16v14M52 22v2" />
  </>)}
  {name === 'tea' && (<>
    <path d="M14 26h28c0 9-6 15-14 15s-14-6-14-15z"/><path d="M12 26h32"/><path d="M18 22c3-4 17-4 20 0"/><path d="M28 18v-2"/>
    <ellipse cx="28" cy="45" rx="16" ry="3"/>
  </>)}
  {name === 'dj' && (<>
    <circle cx="28" cy="28" r="17"/><circle cx="28" cy="28" r="5"/><circle cx="28" cy="28" r="11" stroke-dasharray="2 4"/><path d="M42 10l-8 12"/>
  </>)}
  {name === 'mk' && (<>
    <path d="M10 30h20c0 7-4 11-10 11s-10-4-10-11z"/><path d="M34 22l10-8M36 30l12-4"/><path d="M14 24c-1-3 2-4 1-7M24 24c-1-3 2-4 1-7"/><path d="M8 45h26"/>
  </>)}
  {name === 'cert' && (<>
    <path d="M8 18h40v7a4 4 0 0 0 0 8v7H8v-7a4 4 0 0 0 0-8z"/><path d="M20 18v24" stroke-dasharray="2 3"/><path d="M28 30h12M28 25h8"/>
  </>)}
  {name === 'arrow' && (<path d="M14 28h28M32 18l10 10-10 10"/>)}
</svg>
