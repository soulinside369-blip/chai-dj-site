---
// Компактные карточки форматов: на телефоне листаются вбок, «Посчитать» перестраивает конструктор или открывает расчёт
import Icon from './Icon.astro';
import { formats, site, url } from '../lib/data';
import { rub } from '../lib/price.js';
const certFrom = Math.min(...site.certificates.nominals.map((n) => n.value));
const items = [
  ...formats.map((f) => ({ key: f.key, href: f.slug + '/', name: f.name, line: f.line, meta: `${f.duration} · ${f.guestsLabel}`, price: f.base, per: Math.round(f.base / f.G / 50) * 50, main: f.key === 'teadj' })),
  { key: 'cert', href: 'sertifikaty/', name: 'Сертификат', line: `Подарок на сумму или формат, ${site.certificates.validity}`, meta: 'PDF или печатный', price: certFrom, per: 0, main: false },
];
---
<ul class="fmt-rail">
  {items.map((f) => (
    <li class={`fcard${f.main ? ' main' : ''}`}>
      <div class="fcard-top">
        <Icon name={f.key} class="ico" />
        {f.main && <span class="badge">Главный</span>}
      </div>
      <h3><a href={url(f.href)} class="fcard-link">{f.name}</a></h3>
      <p class="fcard-line">{f.line}</p>
      <p class="fcard-meta">{f.meta}</p>
      <div class="fcard-foot">
        <p class="fcard-price tnum">от {rub(f.price)}{f.per > 0 && <small>≈ {rub(f.per)} / гость</small>}</p>
        <a class="btn sm fcard-btn" href={url(f.href)} data-calc-link data-fmt={f.key} data-goal="click_calc" aria-label={`Посчитать: ${f.name}`}>Посчитать</a>
      </div>
    </li>
  ))}
</ul>
