---
import Icon from './Icon.astro';
import { formats, site, url } from '../lib/data';
import { rub } from '../lib/price.js';
const certFrom = Math.min(...site.certificates.nominals.map((n) => n.value));
---
<div class="fmt-grid">
  {formats.map((f, i) => (
    <article class={`fmt rv${f.key === 'teadj' ? ' main' : ''}`} data-tilt style={`--d:${i * 0.07}s`}>
      {f.key === 'teadj' && <><i class="glow" aria-hidden="true"></i><span class="eq" aria-hidden="true">{Array.from({ length: 9 }, (_, i) => <i style={`--i:${i}`}></i>)}</span></>}
      <Icon name={f.key} />
      <span class="badge">{f.badge}</span>
      <h3>{f.name}</h3>
      <p class="muted">{f.line}</p>
      <div class="meta"><span>{f.duration} · {f.guestsLabel}</span><b class="tnum">от {rub(f.base)}</b></div>
      <div class="row">
        <a class={`btn sm${f.key === 'teadj' ? ' brass' : ''}`} href={url(f.slug + '/#calc')} data-calc-link data-fmt={f.key} data-goal="click_calc">Рассчитать</a>
        <a class="btn sm ghost" href={url(f.slug + '/')}>Подробнее</a>
      </div>
    </article>
  ))}
  <article class="fmt rv" data-tilt style="--d:.3s">
    <Icon name="cert" />
    <span class="badge">Подарок</span>
    <h3>Сертификат</h3>
    <p class="muted">На сумму или формат. Действует {site.certificates.validity}.</p>
    <div class="meta"><span>PDF или печатный</span><b class="tnum">от {rub(certFrom)}</b></div>
    <div class="row"><a class="btn sm" href={url('sertifikaty/#calc')} data-calc-link data-fmt="cert">Заказать</a><a class="btn sm ghost" href={url('sertifikaty/')}>Подробнее</a></div>
  </article>
</div>
