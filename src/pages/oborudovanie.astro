---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { equipment, url } from '../lib/data';
---
<Base title="Оборудование, чайная карта и требования к площадке" description="Звук, свет, чайная станция и большая чайная карта. Что нужно от площадки: место, электричество, заезд.">
  <PageHero title="Оборудование и чайная карта" eyebrow="Без сюрпризов на площадке" lead="Привозим всё своё и подбираем комплект под число гостей и программу: звук, свет, чайную станцию, воду и мебель. Площадке нужны только место и электричество." crumbs={[{ label: 'Оборудование' }]}>
    <div class="row rv" style="--d:.45s">
      <a class="btn" href={url(equipment.venuePdf || 'docs/trebovaniya-ploshchadki.pdf')} download data-goal="download_pdf">Скачать техтребования, PDF</a>
      <a class="btn ghost" href="#venue">Смотреть на сайте</a>
    </div>
  </PageHero>

  <section class="sec tone-coal" data-htone="coal">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Комплектация</p><h2 data-split>Собираем под ваш вечер</h2></div>
      {(equipment as any).kitNote && <p class="lead rv" style="margin:-8px 0 24px;max-width:60ch">{(equipment as any).kitNote}</p>}
      <div class="tw rv stack-table"><table>
        <thead><tr><th>Что</th><th>Камерное событие</th><th>Большое событие</th></tr></thead>
        <tbody>{equipment.kit.map((r) => <tr><td>{r.what}</td><td data-l="Камерное событие">{r.small}</td><td data-l="Большое событие">{r.large}</td></tr>)}</tbody>
      </table></div>
    </div>
  </section>

  <section class="sec tone-rice" data-htone="rice">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Чайная карта</p><h2 data-split>Чай под каждое состояние вечера</h2></div>
      <ul class="teas" aria-label="Чайная карта">
        {equipment.teas.map((t: any, i) => (
          <li class="tea rv" style={`--d:${i * .06}s;--liq:${t.color || '#C8A165'}`}>
            <span class="tea-cup" aria-hidden="true"><span></span></span>
            <p class="k">{t.kind}</p>
            <h3>{t.name}</h3>
            {t.hanzi && <p class="tea-hz" lang="zh">{t.hanzi}</p>}
            <p class="muted">{t.note}</p>
          </li>
        ))}
      </ul>
      <div class="tea-notes rv">
        {(equipment as any).teasNote && <p class="lead">{(equipment as any).teasNote}</p>}
        {equipment.teasLarge && <p class="lead">{equipment.teasLarge}</p>}
      </div>
    </div>
  </section>

  <section class="sec tone-coal2" data-htone="coal" id="venue">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Техтребования</p><h2 data-split>Что нужно от площадки</h2><p class="lead">Точные требования под ваш вечер мы сами отправляем администратору площадки после брони.</p></div>
      <div class="tw rv stack-table"><table>
        <thead><tr><th>Требование</th><th>Камерное событие</th><th>Большое событие</th></tr></thead>
        <tbody>{equipment.venue.map((r) => <tr><td>{r.what}</td><td data-l="Камерное событие">{r.small}</td><td data-l="Большое событие">{r.large}</td></tr>)}</tbody>
      </table></div>
      <figure class="rv" style="margin-top:40px">
        <svg viewBox="0 0 900 260" role="img" aria-label="Схема расстановки: чайная зона и DJ-зона минимум в 8 метрах друг от друга" style="width:100%;height:auto">
          <rect x="40" y="60" width="200" height="150" rx="10" fill="none" stroke="var(--brass)" stroke-width="1.5" />
          <text x="140" y="130" text-anchor="middle" fill="currentColor" font-family="var(--display)" font-size="24" font-weight="600">Чайная зона</text>
          <text x="140" y="158" text-anchor="middle" fill="var(--on-coal-muted)" font-size="13"><tspan x="140" y="158">от 3 × 3 м</tspan><tspan x="140" y="176">отдельная линия 220 В</tspan></text>
          <rect x="660" y="85" width="200" height="100" rx="10" fill="none" stroke="var(--brass)" stroke-width="1.5" />
          <text x="760" y="132" text-anchor="middle" fill="currentColor" font-family="var(--display)" font-size="24" font-weight="600">DJ-зона</text>
          <text x="760" y="158" text-anchor="middle" fill="var(--on-coal-muted)" font-size="13"><tspan x="760" y="158">от 2 × 2 м</tspan><tspan x="760" y="176">отдельная линия 220 В</tspan></text>
          <path d="M260 135 H640" stroke="var(--on-coal-muted)" stroke-dasharray="6 6" />
          <path d="M260 135 l12 -7 v14 z M640 135 l-12 -7 v14 z" fill="var(--on-coal-muted)" />
          <text x="450" y="122" text-anchor="middle" fill="currentColor" font-size="15" font-weight="700">не ближе 8 м</text>
          <text x="450" y="160" text-anchor="middle" fill="var(--on-coal-muted)" font-size="13">на больших событиях — дальше или в соседнем зале</text>
        </svg>
      </figure>
    </div>
  </section>
</Base>
