---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FormatCards from '../components/FormatCards.astro';
import { formats, occasions, calc, url } from '../lib/data';
import { rub, num } from '../lib/price.js';
---
<Base title="Цены на чайную церемонию и DJ — форматы и что входит" description="Сколько стоит выездная чайная церемония, DJ-сет и «Чай + DJ» в Екатеринбурге: базовые пакеты от 15 000 ₽, надбавки за гостей, часы и выезд. Онлайн-калькулятор.">
  <PageHero title="Форматы и цены" eyebrow="Услуги" crumbs={[{ label: 'Услуги' }]} lead="Пять форматов: от камерного мастер-класса до вечера на 150 гостей. Цены для Екатеринбурга; выезд в область считается по километрам." />
  <section class="tone-rice" data-htone="rice" style="padding-bottom:clamp(40px,6vw,72px)"><div class="wrap"><h2 class="sr-only">Пять форматов</h2><FormatCards /></div></section>

  <section class="sec tone-coal" data-htone="coal">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Сравнение</p><h2>Что входит и что добавляется</h2></div>
      <div class="tw"><table>
        <thead><tr><th></th>{formats.map((f) => <th scope="col">{f.name}</th>)}</tr></thead>
        <tbody>
          <tr><th scope="row">Длительность</th>{formats.map((f) => <td class="nowrap">{f.duration}</td>)}</tr>
          <tr><th scope="row">Гостей в базе</th>{formats.map((f) => <td class="nowrap">{f.guestsLabel}</td>)}</tr>
          <tr><th scope="row">Что входит</th>{formats.map((f) => <td>{f.what.join(', ')}</td>)}</tr>
          <tr><th scope="row">Гость сверх</th>{formats.map((f) => <td class="nowrap">{rub(f.a)}</td>)}</tr>
          <tr><th scope="row">Час сверх</th>{formats.map((f) => <td class="nowrap">{f.b ? rub(f.b) : `фикс. ${num(f.H)} ч`}</td>)}</tr>
          <tr><th scope="row">Цена</th>{formats.map((f) => <td class="nowrap"><b>от {rub(f.base)}</b></td>)}</tr>
        </tbody>
      </table></div>
      <p class="muted" style="margin-top:16px">Для всех форматов: выезд за пределы Екатеринбурга — {calc.perKm} ₽/км в обе стороны, генератор при отсутствии 220 В — {rub(calc.generator)}, больше {calc.individualOver} гостей — индивидуальный расчёт.</p>
      <a class="btn brass" style="margin-top:24px" href={url('kontakty/')} data-calc-link data-goal="click_calc">Посчитать свой вечер <span class="arr">→</span></a>
    </div>
  </section>

  <section class="sec tight tone-coal2" data-htone="coal">
    <div class="wrap">
      <p class="eyebrow" style="margin-bottom:16px">Под повод</p>
      <div class="others">{occasions.map((o) => <a class="other" href={url(o.slug + '/')}><b>{o.name}</b><span class="muted">{o.h1}</span></a>)}</div>
    </div>
  </section>
</Base>
