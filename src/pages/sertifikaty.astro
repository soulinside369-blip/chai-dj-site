---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site, isStub, url } from '../lib/data';
import { rub } from '../lib/price.js';
const c = site.certificates;
---
<Base title="Подарочный сертификат на чайную церемонию и DJ" description={`Сертификат на сумму или формат: чайная церемония, Чай + DJ. Действует ${c.validity}. Екатеринбург.`}>
  <PageHero title={c.title} eyebrow="Сертификаты" lead={c.lead} crumbs={[{ href: 'uslugi/', label: 'Услуги' }, { label: 'Сертификаты' }]}>
    <ul class="nominals">
      {c.nominals.map((n) => (
        <li><a class="nominal" href={url('kontakty/')} data-calc-link data-fmt="cert" data-cert={n.value} data-goal="click_cert">
          <span class="k">{/₽/.test(n.label) ? 'На сумму' : 'Формат'}</span>
          <b>{n.label}</b>
          <span class="muted">{/₽/.test(n.label) ? n.note : `${rub(n.value)} · ${n.note}`}</span>
        </a></li>
      ))}
    </ul>
  </PageHero>

  <section class="sec tone-coal" data-htone="coal">
    <div class="wrap split">
      <div><div class="head"><p class="eyebrow">Как вручить</p><h2>Три шага до подарка</h2></div>
        <ol class="steps steps-col" data-progress>{c.steps.map((s) => <li><b>{s.title}</b><span>{s.text}</span></li>)}</ol></div>
      <div><div class="head"><p class="eyebrow">Срок и условия</p><h2>Без мелкого шрифта</h2></div>
        <ul class="lines" style="font-size:16px">
          <li><span>Срок действия</span><span>{c.validity}</span></li>
          <li><span>Дата события</span><span>выбирает получатель</span></li>
          <li><span>Бронь даты</span><span>не позже чем за 3 дня</span></li>
          {!isStub(c.terms) && <li><span>Перенос и возврат</span><span>{c.terms}</span></li>}
        </ul>
        <a class="btn brass" style="margin-top:24px" href={url('kontakty/')} data-calc-link data-fmt="cert" data-goal="click_cert">Заказать сертификат <span class="arr">→</span></a>
      </div>
    </div>
  </section>
</Base>
