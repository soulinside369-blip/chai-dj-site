---
// Страница формата: программа → что входит → площадка → цена → расчёт (в шторке)
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import OccasionPage from '../components/OccasionPage.astro';
import { formats, occasions, calc, url } from '../lib/data';
import { rub, num } from '../lib/price.js';

export function getStaticPaths() {
  return [
    ...formats.map((f) => ({ params: { slug: f.slug }, props: { f } })),
    // страницы под повод живут в корне рядом с форматами: /na-novyy-god/ и т. д.
    ...occasions.map((o) => ({ params: { slug: o.slug }, props: { o } })),
  ];
}
const { o } = Astro.props as { o?: (typeof occasions)[number] };
const f = (Astro.props as any).f ?? formats[0];
const growth = f.b
  ? [`Гость сверх ${f.G} — ${rub(f.a)}`, `Час сверх ${num(f.H)} — ${rub(f.b)}`, `Выезд за город — ${calc.perKm} ₽/км × 2`]
  : [`Длительность фиксированная — ${num(f.H)} ч`, `Участник сверх ${f.G} — ${rub(f.a)}`, f.maxGuests ? `Максимум ${f.maxGuests} человек` : ''].filter(Boolean);
const others = formats.filter((x) => x.key !== f.key);
---
{o ? (
<Base title={o.seoTitle} description={o.seoDescription} service={{ name: o.h1, description: o.seoDescription, price: formats.find((x) => x.key === o.formats[0])!.base }} faqItems={o.faq}>
  <OccasionPage o={o} />
</Base>
) : (
<Base title={f.seoTitle} description={f.seoDescription} service={{ name: f.name, description: f.seoDescription, price: f.base }}>
  <PageHero title={f.h1} eyebrow={`${f.duration} · ${f.guestsLabel}`} lead={f.lead} crumbs={[{ href: 'uslugi/', label: 'Услуги' }, { label: f.name }]}>
    {f.image && <Photo src={f.image} alt={f.imageAlt} class="hero-media" eager sizes="(max-width: 860px) 100vw, 45vw" />}
    <div class="price-bar">
      <p class="price"><span class="muted">базовый пакет</span><b>от {rub(f.base)}</b></p>
      <a class="btn brass" href={url('kontakty/')} data-calc-link data-fmt={f.key} data-goal="click_calc">Рассчитать стоимость <span class="arr">→</span></a>
    </div>
  </PageHero>

  <section class="sec tone-coal" data-htone="coal">
    <div class="wrap">
      <div class="head-row">
        <div class="head"><p class="eyebrow">Программа</p><h2>Вечер по минутам</h2></div>
        <p class="muted rail-hint" aria-hidden="true">листайте →</p>
      </div>
    </div>
    <ol class="pgm" aria-label="Программа по времени">
      {f.program.map((p, i) => (
        <li class="pgm-card" style={`--i:${i}`}>
          <time class="tnum">{p.time}</time>
          <b>{p.title}</b>
          <span>{p.text}</span>
        </li>
      ))}
    </ol>
    <div class="wrap">
      <div class="pgm-bar" aria-hidden="true"><span></span></div>
    </div>
  </section>

  <section class="sec tone-coal2" data-htone="coal">
    <div class="wrap">
      <div class="head"><p class="eyebrow">В пакете</p><h2>Что привозим</h2></div>
      <ul class="incl">{f.what.map((w) => <li><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 10.5 3 3 7-7"/></svg>{w}</li>)}</ul>
      <div class="spec2">
        <div class="spec">
          <Icon name={f.key} />
          <p class="k">От площадки</p>
          <p>{f.venue}</p>
          <a class="link" href={url('oborudovanie/')}>Все требования →</a>
        </div>
        <div class="spec">
          <p class="k">Сверх пакета</p>
          <ul class="spec-list">{growth.map((g) => <li>{g}</li>)}</ul>
          <a class="btn brass sm" href={url('kontakty/')} data-calc-link data-fmt={f.key}>Посчитать свой вечер</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec tight tone-coal2" data-htone="coal">
    <div class="wrap">
      <p class="eyebrow" style="margin-bottom:16px">Другие форматы</p>
      <div class="others">{others.map((o) => <a class="other" href={url(o.slug + '/')}><b>{o.name}</b><span class="muted">{o.duration} · от {rub(o.base)}</span></a>)}</div>
    </div>
  </section>
</Base>
)}
