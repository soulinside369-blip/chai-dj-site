---
// Страница формата: программа → что входит → площадка → цена → расчёт (в шторке)
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { formats, calc, url } from '../lib/data';
import { rub, num } from '../lib/price.js';

export function getStaticPaths() {
  return formats.map((f) => ({ params: { slug: f.slug }, props: { f } }));
}
const { f } = Astro.props as { f: (typeof formats)[number] };
const growth = f.b
  ? [`Гость сверх ${f.G} — ${rub(f.a)}`, `Час сверх ${num(f.H)} — ${rub(f.b)}`, `Выезд за город — ${calc.perKm} ₽/км × 2`]
  : [`Длительность фиксированная — ${num(f.H)} ч`, `Участник сверх ${f.G} — ${rub(f.a)}`, f.maxGuests ? `Максимум ${f.maxGuests} человек` : ''].filter(Boolean);
const others = formats.filter((x) => x.key !== f.key);
---
<Base title={f.seoTitle} description={f.seoDescription} service={{ name: f.name, description: f.seoDescription, price: f.base }}>
  <PageHero title={f.h1} eyebrow={`${f.duration} · ${f.guestsLabel}`} lead={f.lead} crumbs={[{ href: 'uslugi/', label: 'Услуги' }, { label: f.name }]}>
    <div class="price-bar">
      <p class="price"><span class="muted">базовый пакет</span><b>от {rub(f.base)}</b></p>
      <a class="btn brass" href={url('kontakty/')} data-calc-link data-fmt={f.key} data-goal="click_calc">Рассчитать стоимость <span class="arr">→</span></a>
    </div>
  </PageHero>

  <section class="sec tone-coal" data-htone="coal">
    <div class="wrap split">
      <div>
        <div class="head"><p class="eyebrow">Программа</p><h2>По времени</h2></div>
        <ol class="tl">{f.program.map((p) => <li><time>{p.time}</time><span><b>{p.title}</b><span>{p.text}</span></span></li>)}</ol>
      </div>
      <div class="stack-24">
        <div><div class="head"><p class="eyebrow">Что входит</p><h2>В базовом пакете</h2></div>
          <ul class="ticks">{f.what.map((w) => <li>{w}</li>)}</ul></div>
        <div class="tile"><Icon name={f.key} /><p class="k">От площадки</p><p>{f.venue}</p><a class="link" href={url('oborudovanie/')}>Все требования →</a></div>
        <div class="tile"><p class="k">Сверх пакета</p><ul class="ticks">{growth.map((g) => <li>{g}</li>)}</ul>
          <a class="btn brass sm" href={url('kontakty/')} data-calc-link data-fmt={f.key}>Посчитать свой вечер</a></div>
      </div>
    </div>
  </section>

  <section class="sec tight tone-coal2" data-htone="coal">
    <div class="wrap">
      <p class="eyebrow" style="margin-bottom:16px">Другие форматы</p>
      <div class="others">{others.map((o) => <a class="other" href={url(o.slug + '/')}><b>{o.name}</b><span class="muted">{o.duration} · от {rub(o.base)}</span></a>)}</div>
    </div>
  </section>
</Base>
