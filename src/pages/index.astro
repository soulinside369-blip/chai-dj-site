---
import Base from '../layouts/Base.astro';
import HeroConfigurator from '../components/HeroConfigurator.astro';
import Trailer from '../components/Trailer.astro';
import FormatCards from '../components/FormatCards.astro';
import Cases from '../components/Cases.astro';
import Reviews from '../components/Reviews.astro';
import FaqList from '../components/FaqList.astro';
import { site, url, cases, reviews } from '../lib/data';

// Показываем только реальные материалы: пустые рамки и заглушки посетителю не нужны
const realCases = cases.filter((c) => !c.draft).length > 0;
const realReviews = reviews.filter((r) => !r.draft).length > 0;
---
<Base tone="rice" faqLd>
  {(site.hero as any).scene?.quiet && /-1280\.webp$/.test((site.hero as any).scene.quiet) && <link slot="head" rel="preload" as="image" type="image/webp" imagesrcset={`${url((site.hero as any).scene.quiet.replace(/-1280\.webp$/, '-640.webp'))} 640w, ${url((site.hero as any).scene.quiet.replace(/-1280\.webp$/, '-900.webp'))} 900w, ${url((site.hero as any).scene.quiet)} 1280w`} imagesizes="(max-width: 600px) calc(100vw - 40px), 520px" fetchpriority="high" />}
  <Trailer slot="top" />
  <HeroConfigurator />

  <section class="sec tone-rice2" data-htone="rice" id="formats">
    <div class="wrap">
      <div class="head-row">
        <div class="head"><p class="eyebrow">Форматы</p><h2>Пять форматов — от мастер-класса до вечера на 150 гостей</h2></div>
        <a class="link" href={url('uslugi/')}>Сравнить форматы →</a>
      </div>
      <FormatCards />
    </div>
  </section>

  <section class="sec tone-coal" data-htone="coal">
    <div class="wrap how">
      <div>
        <div class="head"><p class="eyebrow">Как это работает</p><h2>Четыре шага до вечера</h2></div>
        <ol class="steps steps-compact" data-progress>
          {site.steps.map((s) => <li><b>{s.title}</b><span>{s.text}</span></li>)}
        </ol>
        {Object.entries(site.segmentNotes).map(([k, n]) => (
          <p class="seg-line" data-only={k}><b>{n.title}.</b> <span class="muted">{n.text}</span> <a class="link" href={url(n.link)}>{n.linkLabel} →</a></p>
        ))}
      </div>
      <div>
        <div class="head"><p class="eyebrow">Вопросы</p><h2>Коротко о главном</h2></div>
        <FaqList top limit={3} />
        <a class="link" style="display:inline-block;margin-top:16px" href={url('faq/')}>Все вопросы →</a>
      </div>
    </div>
  </section>

  {realCases && (
    <section class="sec tone-coal2" data-htone="coal">
      <div class="wrap">
        <div class="head-row">
          <div class="head"><p class="eyebrow">Кейсы</p><h2>Где мы уже были</h2></div>
          <a class="link" href={url('keysy/')}>Все кейсы →</a>
        </div>
        <Cases limit={3} onlyReal />
      </div>
    </section>
  )}

  {realReviews && (
    <section class="sec tone-coal" data-htone="coal">
      <div class="wrap">
        <div class="head"><p class="eyebrow">Отзывы</p><h2>Что говорят заказчики</h2></div>
        <Reviews onlyReal />
      </div>
    </section>
  )}

</Base>
