---
import Base from '../layouts/Base.astro';
import HeroConfigurator from '../components/HeroConfigurator.astro';
import FormatCards from '../components/FormatCards.astro';
import Photo from '../components/Photo.astro';
import Cases from '../components/Cases.astro';
import Reviews from '../components/Reviews.astro';
import Calculator from '../components/Calculator.astro';
import FaqList from '../components/FaqList.astro';
import { site, url, cases, reviews } from '../lib/data';

const a = site.atmosphere;
const marquee = ['Бай Му Дань', 'Бас', 'Гайвань', 'Тёплый свет', 'Те Гуань Инь', 'Танцпол', 'Шу пуэр', 'Микрофон ведущему', 'Чабань', 'Финальный трек'];
// Кейсы и отзывы показываем на главной, только когда есть реальные (не черновики)
const realCases = cases.filter((c) => !c.draft).length > 0;
const realReviews = reviews.filter((r) => !r.draft).length > 0;
---
<Base tone="rice" faqLd>
  <!-- 1. Первый экран: конструктор вечера -->
  <HeroConfigurator />

  <div class="marquee tone-rice" data-htone="rice" aria-hidden="true">
    <div class="marquee-track">{[0, 1].map(() => marquee.map((m) => <span>{m}</span>))}</div>
  </div>

  <!-- 2. Форматы -->
  <section class="sec tone-rice" data-htone="rice" id="formats">
    <div class="wrap">
      <div class="head-row">
        <div class="head"><p class="eyebrow">Форматы</p><h2 data-split>Пять форматов — от камерного мастер-класса до вечера на 150 гостей</h2></div>
        <a class="btn ghost sm" href={url('uslugi/')}>Сравнить форматы</a>
      </div>
      <FormatCards />
    </div>
  </section>

  <!-- 3. Атмосфера -->
  <section class="sec tone-coal" data-htone="coal">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Атмосфера</p><h2 data-split>{a.title}</h2></div>
      <div class="gallery">
        {a.teaser
          ? <video class="photo rv" controls preload="none" playsinline src={url(a.teaser)} aria-label="Тизер вечера"></video>
          : <div class="photo empty rv" role="img" aria-label="Тизер 30–45 секунд"><span class="play-btn" aria-hidden="true">▶</span><span><b>Тизер 30–45 с</b>запуск по клику — загрузите видео в админке</span></div>}
        {a.photos.map((ph) => <Photo src={ph.photo} alt={ph.alt} need={ph.need} class="rv" />)}
      </div>
    </div>
  </section>

  <!-- 4. Как это работает + заметка под аудиторию -->
  <section class="sec tone-coal2" data-htone="coal">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Как это работает</p><h2 data-split>От заявки до последнего трека — четыре шага</h2></div>
      <ol class="steps" data-progress>
        {site.steps.map((s, i) => <li class="rv" style={`--d:${i * 0.1}s`}><b>{s.title}</b><span>{s.text}</span></li>)}
      </ol>
      {Object.entries(site.segmentNotes).map(([k, n]) => (
        <aside class="seg-note rv" data-only={k}>
          <div><p class="h3 display">{n.title}</p><p class="muted">{n.text}</p></div>
          <a class="btn ghost sm" href={url(n.link)}>{n.linkLabel} <span class="arr">→</span></a>
        </aside>
      ))}
    </div>
  </section>

  {realCases && (
    <section class="sec tone-coal" data-htone="coal">
      <div class="wrap">
        <div class="head-row">
          <div class="head"><p class="eyebrow">Кейсы</p><h2 data-split>Где мы уже были</h2></div>
          <a class="btn ghost sm" href={url('keysy/')}>Все кейсы</a>
        </div>
        <Cases limit={3} />
      </div>
    </section>
  )}

  {realReviews && (
    <section class="sec tone-coal2" data-htone="coal">
      <div class="wrap">
        <div class="head"><p class="eyebrow">Отзывы</p><h2 data-split>Что говорят заказчики</h2></div>
        <Reviews />
      </div>
    </section>
  )}

  <!-- Подробный калькулятор -->
  <section class="sec tone-coal" data-htone="coal" aria-labelledby="calc-title">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Подробный расчёт</p><h2 id="calc-title" data-split>Учтём выезд, часы и площадку</h2><p class="lead">Примерная стоимость — сразу, до звонка. Точную смету пришлёт менеджер.</p></div>
      <Calculator />
    </div>
  </section>

  <!-- FAQ -->
  <section class="sec tone-coal2" data-htone="coal">
    <div class="wrap split">
      <div class="head" style="align-content:start"><p class="eyebrow">Вопросы</p><h2 data-split>Коротко о главном</h2><p class="lead">Не нашли ответ — напишите в Telegram, ответим за {site.work.replyMinutes} минут в рабочее время.</p><a class="btn ghost sm" style="justify-self:start" href={url('faq/')}>Все вопросы</a></div>
      <FaqList top />
    </div>
  </section>
</Base>
