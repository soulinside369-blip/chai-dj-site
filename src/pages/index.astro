---
import Base from '../layouts/Base.astro';
import HeroConfigurator from '../components/HeroConfigurator.astro';
import FormatCards from '../components/FormatCards.astro';
import Photo from '../components/Photo.astro';
import Cases from '../components/Cases.astro';
import Reviews from '../components/Reviews.astro';
import FaqList from '../components/FaqList.astro';
import { site, url, cases, reviews } from '../lib/data';

const a = site.atmosphere;
// Показываем только реальные материалы: пустые рамки и заглушки посетителю не нужны
const photos = a.photos.filter((p) => p.photo);
const hasAtmosphere = photos.length > 0 || !!a.teaser;
const realCases = cases.filter((c) => !c.draft).length > 0;
const realReviews = reviews.filter((r) => !r.draft).length > 0;
---
<Base tone="rice" faqLd>
  <HeroConfigurator />

  <section class="sec tone-rice2" data-htone="rice" id="formats">
    <div class="wrap">
      <div class="head-row">
        <div class="head"><p class="eyebrow">Форматы</p><h2>Пять форматов — от мастер-класса до вечера на 150 гостей</h2></div>
        <a class="link" href={url('uslugi/')}>Сравнить форматы →</a>
      </div>
      <FormatCards />
    </div>
  </section>

  {hasAtmosphere && (
    <section class="sec tone-coal" data-htone="coal">
      <div class="wrap">
        <div class="head"><p class="eyebrow">Атмосфера</p><h2>{a.title}</h2></div>
        <div class="gallery">
          {a.teaser && <video class="photo" controls preload="none" playsinline src={url(a.teaser)} aria-label="Тизер вечера"></video>}
          {photos.map((ph) => <Photo src={ph.photo} alt={ph.alt} class="rv" />)}
        </div>
      </div>
    </section>
  )}

  <section class="sec tone-coal" data-htone="coal">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Как это работает</p><h2>От заявки до последнего трека — четыре шага</h2></div>
      <ol class="steps" data-progress>
        {site.steps.map((s, i) => <li class="rv" style={`--d:${i * 0.08}s`}><b>{s.title}</b><span>{s.text}</span></li>)}
      </ol>
      {Object.entries(site.segmentNotes).map(([k, n]) => (
        <aside class="seg-note" data-only={k}>
          <p><b>{n.title}.</b> <span class="muted">{n.text}</span></p>
          <a class="link" href={url(n.link)}>{n.linkLabel} →</a>
        </aside>
      ))}
    </div>
  </section>

  {realCases && (
    <section class="sec tone-coal2" data-htone="coal">
      <div class="wrap">
        <div class="head-row">
          <div class="head"><p class="eyebrow">Кейсы</p><h2>Где мы уже были</h2></div>
          <a class="link" href={url('keysy/')}>Все кейсы →</a>
        </div>
        <Cases limit={3} onlyReal />
      </div>
    </section>
  )}

  {realReviews && (
    <section class="sec tone-coal" data-htone="coal">
      <div class="wrap">
        <div class="head"><p class="eyebrow">Отзывы</p><h2>Что говорят заказчики</h2></div>
        <Reviews onlyReal />
      </div>
    </section>
  )}

  <section class="sec tone-coal2" data-htone="coal">
    <div class="wrap split">
      <div class="head" style="align-content:start"><p class="eyebrow">Вопросы</p><h2>Коротко о главном</h2><p class="muted">Не нашли ответ — напишите в Telegram, ответим за {site.work.replyMinutes} минут в рабочее время.</p><a class="link" href={url('faq/')}>Все вопросы →</a></div>
      <FaqList top />
    </div>
  </section>
</Base>
