---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { site, isStub } from '../lib/data';
const a = site.about;
const people = a.people.filter((p) => !isStub(p.name));
const atm = site.atmosphere;
const photos = atm.photos.filter((p) => p.photo);
---
<Base title="О нас: чайный мастер и DJ" description={a.lead}>
  <PageHero title={a.title} eyebrow="О нас" lead={a.lead} crumbs={[{ label: 'О нас' }]} />

  {people.length > 0 && (
    <section class="tone-rice" data-htone="rice" style="padding-bottom:clamp(40px,6vw,72px)">
      <div class="wrap people">
        {people.map((p) => (
          <article class="person">
            {p.photo ? <Photo src={p.photo} alt={`${p.role}: ${p.name}`} class="person-photo" /> : <span class="person-ico" aria-hidden="true"><Icon name={/DJ/.test(p.role) ? 'dj' : 'tea'} /></span>}
            <div><p class="k">{p.role}</p><h2 class="h3">{p.name}</h2>{!isStub(p.text) && <p class="muted">{p.text}</p>}</div>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="sec tone-coal" data-htone="coal">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Принципы</p><h2>Как мы работаем</h2></div>
      <div class="grid4">{a.principles.map((p) => <article class="tile"><h3>{p.title}</h3><p class="muted">{p.text}</p></article>)}</div>
    </div>
  </section>
  {photos.length > 0 && (
    <section class="sec tone-coal2" data-htone="coal">
      <div class="wrap">
        <div class="head"><p class="eyebrow">Атмосфера</p><h2>{atm.title}</h2></div>
        <div class="gallery">{photos.map((ph) => <Photo src={ph.photo} alt={ph.alt} />)}</div>
      </div>
    </section>
  )}
</Base>
